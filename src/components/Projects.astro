---
import { oralSessions, oralTeams, booths, clubs } from "../data/event";

const clubName = (id: string) => clubs.find((c) => c.id === id)?.name ?? id;
---

<section id="projects" class="border-t border-ink bg-white">
  <div class="wrap py-20 sm:py-28">
    <h2 class="h-section inline-block border-b border-ink pr-16 pb-5">발표 프로젝트</h2>
    <p class="mt-6 max-w-2xl text-lg font-medium">완성도·학술성·확장성을 기준으로 선정된 우수 발표 9팀과, 전체 부스의 포스터 프로젝트를 소개합니다.</p>

    <h3 class="mt-14 text-2xl font-extrabold tracking-tight">우수 발표회 (Oral)</h3>
    <p class="mt-1 text-muted">팀당 발표 15분 + 질의응답 5분</p>
    <div class="mt-4">
      {oralSessions.map((s) => {
        const teams = oralTeams.filter((t) => t.session === s.session);
        return (
          <div class="grid gap-x-8 gap-y-4 border-b border-ink py-8 md:grid-cols-[250px_1fr]">
            <div>
              <p class="text-2xl font-normal tracking-tight">Session {s.session}</p>
              <p class="mt-1 tabular-nums text-muted">{s.time}</p>
            </div>
            <ol class="space-y-4">
              {(teams.length ? teams : [null, null, null]).map((t, i) => (
                <li class="flex gap-5">
                  <span class="w-6 shrink-0 font-mono text-sm leading-7 text-soft">{String(i + 1).padStart(2, "0")}</span>
                  {t ? (
                    <div>
                      <p class="text-lg font-medium">{t.title}</p>
                      <p class="text-sm text-muted">{clubName(t.club)}{t.members && ` · ${t.members}`}</p>
                      {t.summary && <p class="mt-1 text-[15px] leading-relaxed text-muted">{t.summary}</p>}
                    </div>
                  ) : (
                    <p class="text-lg text-soft">선정 후 공개</p>
                  )}
                </li>
              ))}
            </ol>
          </div>
        );
      })}
    </div>

    <h3 class="mt-16 text-2xl font-extrabold tracking-tight">포스터 부스</h3>
    {booths.length ? (
      <ol class="mt-4">
        {booths.map((b) => (
          <li class="grid grid-cols-[64px_1fr] gap-x-6 gap-y-1 border-b border-ink py-5 md:grid-cols-[100px_1fr_160px_200px]">
            <span class="font-mono text-lg">#{b.no}</span>
            <span class="text-lg font-medium">
              {b.title}
              {b.oral && <span class="bg-grad ml-2 rounded-[3px] border border-ink px-1.5 py-0.5 align-middle text-[11px] font-bold tracking-[0.08em]">ORAL</span>}
            </span>
            <span class="col-start-2 text-muted md:col-start-auto">{clubName(b.club)}</span>
            <span class="col-start-2 text-muted md:col-start-auto">{b.field ?? "-"}</span>
          </li>
        ))}
      </ol>
    ) : (
      <p class="mt-4 border-y border-ink py-8 text-lg text-soft">부스 목록은 참여 프로젝트가 확정되면 부스 번호와 함께 공개됩니다.</p>
    )}
  </div>
</section>
