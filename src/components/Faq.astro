---
import { faqs } from "../data/event";
---

<section id="faq" class="border-t border-ink bg-white">
  <div class="wrap grid gap-10 py-20 sm:py-28 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <h2 class="h-section">FAQ</h2>
      <p class="mt-4 text-muted">더 궁금한 점은 각 학회 운영진에게 문의해 주세요.</p>
    </div>
    <div class="border-t border-ink">
      {faqs.map((f) => (
        <details class="group border-b border-ink py-6">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-bold [&::-webkit-details-marker]:hidden">
            {f.q}
            <span aria-hidden="true" class="text-2xl font-light transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 leading-relaxed text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
