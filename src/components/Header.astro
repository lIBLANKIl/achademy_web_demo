---
const nav: { href: string; label: string; modal?: boolean }[] = [
  { href: "#about", label: "소개" },
  { href: "#clubs", label: "참여 학회" },
  { href: "#program", label: "프로그램" },
  { href: "#projects", label: "발표 프로젝트" },
  { href: "#booths", label: "부스 안내" },
  { href: "#faq", label: "FAQ" },
  { href: "#register", label: "참관 신청", modal: true },
];
---

<header id="site-header" class="sticky top-0 z-40 bg-white transition-shadow data-[scrolled]:shadow-[0_1px_0_rgba(10,13,18,0.12),0_4px_16px_rgba(10,13,18,0.06)]">
  <div class="wrap flex h-[72px] items-center justify-between gap-4">
    <a href="#top" class="flex items-center gap-3">
      <svg aria-hidden="true" viewBox="0 0 40 40" class="size-9">
        <defs><linearGradient id="lg-h" x1="0" x2="1"><stop offset="0" stop-color="#c8e264" /><stop offset="1" stop-color="#7fd0ea" /></linearGradient></defs>
        <path d="M10 12 L30 12 L20 30 Z" fill="none" stroke="#0a0d12" stroke-width="1.6" />
        <circle cx="10" cy="12" r="6" fill="url(#lg-h)" stroke="#0a0d12" stroke-width="1.6" />
        <circle cx="30" cy="12" r="6" fill="#fff" stroke="#0a0d12" stroke-width="1.6" />
        <circle cx="20" cy="30" r="6" fill="#0a0d12" />
      </svg>
      <span class="leading-[1.1] font-extrabold tracking-tight text-ink">
        <span class="block text-[15px]">명품스터디클럽</span>
        <span class="block text-[13px] font-semibold text-muted">연합 학술 박람회</span>
      </span>
    </a>

    <nav aria-label="주요 메뉴" class="hidden lg:block">
      <ul class="flex items-center gap-8 text-[15px] font-bold text-ink">
        {nav.map((n) => (
          <li><a href={n.href} data-open-register={n.modal ? "" : undefined} class="transition-colors hover:text-muted">{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <button
      id="menu-btn"
      type="button"
      class="grid size-10 place-items-center text-ink lg:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="메뉴 열기"
    >
      <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h18M3 12h18M3 17h18" /></svg>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="모바일 메뉴" class="hidden border-t border-ink/10 bg-white lg:hidden">
    <ul class="wrap py-2 text-lg font-bold">
      {nav.map((n) => (
        <li class="border-b border-ink/10 last:border-0"><a href={n.href} data-open-register={n.modal ? "" : undefined} class="block py-3.5">{n.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById("site-header");
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");

  const onScroll = () => header?.toggleAttribute("data-scrolled", window.scrollY > 4);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    btn?.setAttribute("aria-expanded", String(open));
    btn?.setAttribute("aria-label", open ? "메뉴 닫기" : "메뉴 열기");
  };
  btn?.addEventListener("click", () => setOpen(menu?.classList.contains("hidden") ?? false));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
</script>
